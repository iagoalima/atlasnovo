{
  "name": "atlas",
  "version": "1.0.0",
  "description": "Sistema de Condecorações para Discord",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/core/index.ts",
    "register": "tsx src/core/discord/register-commands.ts",
    "build": "prisma generate && tsc",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "start": "npm run db:push && node dist/core/index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "discord",
    "discord-bot",
    "typescript",
    "prisma",
    "sqlite"
  ],
  "author": "ClaudirDoPneu",
  "license": "MIT",
  "dependencies": {
    "@devjacob/discord-html-transcripts": "^4.5.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}